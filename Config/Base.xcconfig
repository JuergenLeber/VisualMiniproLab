//
//  Base.xcconfig
//  Visual Minipro
//
//  Project wide identity and signing. Override anything here in
//  Config/Local.xcconfig, which is git-ignored - see Config/Local.xcconfig.example.
//

// Bundle identifiers are built from this, e.g. dev.leber.VisualMinipro. Apple
// registers a bundle identifier to one team only, so distributing the app needs
// an identifier of your own rather than the one upstream uses.
ORG_IDENTIFIER = dev.leber

// The name of the app bundle and what the user sees in the Dock and menu bar.
// The target and the Swift module stay "Visual Minipro", so tests keep importing
// Visual_Minipro.
APP_PRODUCT_NAME = Visual Minipro Lab

// Ad-hoc signing ("Sign to Run Locally"): builds and runs on this Mac without a
// developer account. Set DEVELOPMENT_TEAM and CODE_SIGN_STYLE in
// Config/Local.xcconfig to sign with a real identity instead.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY[sdk=macosx*] = -

// Hardened runtime turns on library validation, which only lets the app load
// libraries signed by the same team. An ad-hoc signature has no team, so the
// embedded libusb cannot be loaded and the app dies at launch. Distribution
// builds sign everything with one team and need this on - turn it on in
// Config/Local.xcconfig together with DEVELOPMENT_TEAM.
ENABLE_HARDENED_RUNTIME = NO

#include? "Local.xcconfig"
